# Copy to backend/.env. Restart the backend after changing settings.
# Only these two chat models are supported:
#   llama3.2:3b  (default)
#   llama3.1:8b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_GPU=0

# Embeddings run locally and are separate from the chat model.
# EMBEDDING_PROVIDER=local
# RETRIEVAL_TOP_K=5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# SEARCH_HYBRID=1
# SEARCH_RERANK=0
# RETRIEVAL_CANDIDATES=20
